name: college_makers
description: "Collage maker app"
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.13.3

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8
  google_fonts: ^6.2.1
  image_picker: ^1.1.2
  share_plus: ^10.1.4
  gal: ^2.3.0
  video_player: ^2.9.2
  path_provider: ^2.1.4
  file_picker: ^11.0.3
  ffmpeg_kit_flutter_new_full: ^2.5.5

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
  assets:
    - assets/templates/
    - assets/templates/bg/
    - assets/samples/
